{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeadOS Berichtsindex",
  "type": "object",
  "required": ["reports"],
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "typ", "datum", "titel", "pfad"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "typ": {
            "type": "string",
            "enum": ["Protokoll", "Tagesbericht", "Monatsbericht", "Abschlussbericht"]
          },
          "datum": { "type": "string", "format": "date" },
          "titel": { "type": "string", "maxLength": 120 },
          "pfad": { "type": "string", "pattern": "^reports/.+\\.json$" }
        }
      }
    }
  }
}

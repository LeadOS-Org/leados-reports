{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeadOS Einzelbericht",
  "type": "object",
  "required": ["id", "typ", "datum", "titel", "meta", "abschnitte"],
  "properties": {
    "id": { "type": "string" },
    "typ": { "type": "string", "enum": ["Protokoll", "Tagesbericht", "Monatsbericht", "Abschlussbericht"] },
    "datum": { "type": "string", "format": "date" },
    "titel": { "type": "string" },
    "meta": {
      "type": "object",
      "properties": {
        "teilnehmer": { "type": "array", "items": { "type": "string" } },
        "anlass": { "type": "string" }
      }
    },
    "abschnitte": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["titel", "typ"],
        "properties": {
          "titel": { "type": "string" },
          "typ": { "type": "string", "enum": ["text", "tabelle", "fragen_antworten", "liste"] },
          "inhalt": {}
        }
      }
    }
  }
}
